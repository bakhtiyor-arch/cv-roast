# AI CV Roaster Backend - Environment Variables
# Copy this file to .env and fill in the values

# Groq API Key (required) — get yours at https://console.groq.com/keys
# Format: GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx
GROQ_API_KEY=gsk_your_groq_api_key_here

# Groq Model (optional, defaults to qwen/qwen3.8-27b)
# GROQ_MODEL=qwen/qwen3.8-27b

# Django Settings
DJANGO_SECRET_KEY=replace-with-a-real-secret-key
DEBUG=False
ALLOWED_HOSTS=cv-roast.uz,www.cv-roast.uz,localhost,127.0.0.1

# CORS (comma-separated origins)
CORS_ALLOWED_ORIGINS=https://cv-roast.uz,https://www.cv-roast.uz,http://localhost:3000

# CV Upload Limits
CV_FILE_MAX_SIZE_MB=5
CV_FILE_MIN_TEXT_LENGTH=50
