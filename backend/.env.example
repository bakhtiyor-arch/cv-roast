# AI CV Roaster Backend - Environment Variables
# Copy this file to .env and fill in the values

# Google Gemini API Key (required) — get yours at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model (optional, defaults to gemini-1.5-flash)
# GEMINI_MODEL=gemini-1.5-flash

# Django Settings
DJANGO_SECRET_KEY=replace-with-a-real-secret-key
DEBUG=False
ALLOWED_HOSTS=cv-roast.uz,www.cv-roast.uz,localhost,127.0.0.1

# CORS (comma-separated origins)
CORS_ALLOWED_ORIGINS=https://cv-roast.uz,https://www.cv-roast.uz,http://localhost:3000

# CV Upload Limits
CV_FILE_MAX_SIZE_MB=5
CV_FILE_MIN_TEXT_LENGTH=50
